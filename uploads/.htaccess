# =====================================================================
#  Fleetra — uploads directory
#  Uploaded files are served, never executed.
# =====================================================================

Options -Indexes -ExecCGI

# Refuse to run anything script-like that somehow lands in uploads/.
<FilesMatch "\.(php|php[0-9]?|phtml|phar|pl|py|rb|cgi|asp|aspx|jsp|jspx|sh|bat|exe|htm|html|svg)$">
    Require all denied
</FilesMatch>
