# =====================================================================
#  Fleetra — environment template
# ---------------------------------------------------------------------
#  Copy this file to ".env" and fill in the values for your host.
#
#      cp .env.example .env
#
#  The application reads real environment variables first and falls back
#  to this file, so on a PaaS (Render, Railway, Koyeb, ...) you can set
#  these in the dashboard instead and leave no .env on disk.
#
#  If ".env" is missing entirely, Fleetra uses the safe local XAMPP
#  defaults, so nothing here is required for local development.
#
#  IMPORTANT: ".env" holds secrets. Never commit it. It is already listed
#  in .gitignore, and the root .htaccess blocks the browser from reaching
#  it.
# =====================================================================

# ---------------------------------------------------------------------
#  Application
# ---------------------------------------------------------------------
# "local" (default) shows demo credentials and on-screen reset links.
# "production" turns the demo helpers off — use this on any public URL.
APP_ENV=production

# Force the demo credential panel on/off regardless of APP_ENV.
# Leave unset and it follows APP_ENV (on locally, off in production).
# SHOW_DEMO_CREDENTIALS=false

# Business timezone used for schedules, departures and reports.
APP_TIMEZONE=Asia/Kolkata

# Currency symbol shown on fares, tickets and reports.
APP_CURRENCY=₹

# Idle logout timer, in seconds (default 3600 = 60 minutes).
SESSION_IDLE_TIMEOUT=3600

# Only needed when base-URL auto-detection is wrong (reverse proxies,
# symlinked document roots). Examples: "/" or "/fleetra/".
# APP_BASE_URL=/

# ---------------------------------------------------------------------
#  Database
# ---------------------------------------------------------------------
# Most free MySQL hosts give you a hostname, database name, username and
# password that differ from the XAMPP defaults. For example InfinityFree
# looks like:
#     DB_HOST=sql200.infinityfree.com
#     DB_NAME=if0_12345678_fleetra
#     DB_USER=if0_12345678
#     DB_PASS=your-vpanel-password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fleetra_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# Managed MySQL hosts (Aiven, PlanetScale, ...) require TLS. Point this at
# the CA certificate they provide and the connection switches to TLS.
# DB_SSL_CA=/var/www/html/ca.pem
# DB_SSL_VERIFY=true
